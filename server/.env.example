# MySQL connection (defaults shown)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=SkiResorts

# OpenWeather key for the weather panel and radar map.
# Keep it here on the server only; never put it in client/.env.
OPENWEATHER_API_KEY=your_openweather_api_key

# Allowed browser origins for cross-origin API calls (comma-separated). Leave
# unset in development: the Vite dev server proxies /api, so no CORS is needed.
# Set it only if a separately hosted frontend calls this API directly.
# CORS_ORIGINS=https://example.com

# Set to 0 to disable the Flask debug reloader. Defaults to 1 for local dev.
# FLASK_DEBUG=1
